# ==========================================================
# Veritas Engine - backend configuration (copy to .env)
# All variables are optional. Prefix: VERITAS_
# ==========================================================

VERITAS_ENVIRONMENT=development
VERITAS_LOG_LEVEL=INFO
# Comma separated list (JSON array also accepted)
VERITAS_CORS_ORIGINS=["http://localhost:3000"]

# ---------------- BYOK ----------------
# Provider used when the request does not send X-Provider.
# One of: gemini | anthropic | openai | groq | ollama
VERITAS_DEFAULT_PROVIDER=

# Server-side fallback keys (used ONLY when the request has no X-API-Key and
# VERITAS_ALLOW_ENV_FALLBACK=true). Leave empty in public/multi-tenant deployments.
VERITAS_ALLOW_ENV_FALLBACK=true
VERITAS_GEMINI_API_KEY=
VERITAS_ANTHROPIC_API_KEY=
VERITAS_OPENAI_API_KEY=
VERITAS_GROQ_API_KEY=

# Accept X-Endpoint-URL from clients (Ollama / OpenAI-compatible servers such as vLLM).
VERITAS_ALLOW_CUSTOM_ENDPOINTS=true
VERITAS_OLLAMA_BASE_URL=http://localhost:11434

# Default models per provider (can be overridden per request with X-Model)
VERITAS_GEMINI_MODEL=gemini-2.5-flash
VERITAS_ANTHROPIC_MODEL=claude-sonnet-5-5
VERITAS_OPENAI_MODEL=gpt-4o
VERITAS_GROQ_MODEL=llama-3.3-70b-versatile
VERITAS_OLLAMA_MODEL=llama3.1
VERITAS_LLM_TIMEOUT_SECONDS=60

# ---------------- Government connectors ----------------
VERITAS_CONNECTOR_TIMEOUT_SECONDS=8
VERITAS_CONNECTOR_MAX_RETRIES=3
VERITAS_CONNECTOR_BACKOFF_BASE_SECONDS=0.5
VERITAS_CONNECTOR_CACHE_TTL_SECONDS=900
VERITAS_CONNECTOR_CACHE_MAX_ENTRIES=1024
